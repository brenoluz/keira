{
  "name": "keira",
  "version": "1.0.0",
  "description": "TypeScript browser-side MVC framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./src/*": {
      "types": "./dist/src/*.d.ts",
      "import": "./dist/src/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marxluz/keira.git"
  },
  "keywords": [
    "typescript",
    "mvc",
    "browser",
    "framework"
  ],
  "author": "Breno M Luz",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marxluz/keira/issues"
  },
  "homepage": "https://github.com/marxluz/keira#readme",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3"
  }
}
